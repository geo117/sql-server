# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y completa tus valores. NO subas `.env` a git.
# ---------------------------------------------------------------------------

# --- Conexion a SQL Server -------------------------------------------------
DB_SERVER=localhost
DB_NAME=master
# Autenticacion SQL Server (usuario/contraseña).
DB_USER=monitor_user
DB_PASSWORD=cambia_esta_password
# Autenticacion Windows: pon DB_TRUSTED_CONNECTION=yes y deja DB_USER/DB_PASSWORD vacios.
DB_TRUSTED_CONNECTION=no
DB_DRIVER={ODBC Driver 17 for SQL Server}
# Encrypt=yes requiere certificado de confianza. Usa `yes` en produccion.
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=5

# --- Seguridad -------------------------------------------------------------
# Si defines API_KEY, todas las rutas /api exigen la cabecera `X-API-Key`.
# Dejalo vacio solo para desarrollo local aislado.
API_KEY=
# Origenes permitidos por CORS, separados por coma. Evita "*" en produccion.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Reglas de operacion ---------------------------------------------------
# SPIDs por debajo de este valor se consideran de sistema y no se pueden matar.
KILL_MIN_USER_SPID=51
# Maximo de intentos de KILL por minuto (protege contra bucles accidentales).
KILL_RATE_LIMIT_PER_MINUTE=10
